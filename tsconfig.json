{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",

        "declaration": true,

        "moduleResolution": "node",
        "noImplicitAny": false,

        "allowSyntheticDefaultImports": true,
        "esModuleInterop":true,

        "downlevelIteration": true,

        "rootDir": "src",
        "baseUrl": "src",

        "sourceMap": false,
        "outDir": "dist",
    },

    "include": [ "src/**/*.ts" ],
    "exclude": [ "dist", "node_modules" ]
}